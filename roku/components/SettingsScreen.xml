<?xml version="1.0" encoding="utf-8"?>
<!-- SettingsScreen.xml - matches Flutter Settings layout: left category list + right content panel -->
<component name="SettingsScreen" extends="Group">
    <interface>
        <field id="visible" type="boolean" value="false" onChange="onVisibleChange" />
        <field id="settingsChanged" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/SettingsScreen.brs" />
    <children>
        <!-- Transparent: app background (0x111316) shows through -->

        <!-- Left panel: category list (Flutter: General, Playback, AI Features, Recordings) -->
        <Rectangle id="leftPanel" translation="[0, 0]" width="240" height="1080" color="0x1A1A2EFF" />
        <Label translation="[20, 30]" text="Settings"
            font="font:LargeBoldSystemFont" color="0xE8E8E8FF" />

        <LabelList id="tabList" translation="[0, 90]"
            itemSize="[240, 56]"
            numRows="6"
            font="font:MediumSystemFont"
            color="0xB3B3B3FF"
            focusedColor="0xE8E8E8FF"
            focusBitmapBlendColor="0x2E3192FF" />

        <!-- Divider -->
        <Rectangle translation="[240, 0]" width="1" height="1080" color="0x2A2A2AFF" />

        <!-- Right panel: content area -->
        <Group id="settingsContent" translation="[260, 40]">

            <!-- General Settings Panel -->
            <Group id="generalSettings" visible="true">
                <Label text="General" font="font:LargeBoldSystemFont" color="0xE8E8E8FF" />

                <!-- Playlist Status -->
                <Group translation="[0, 60]">
                    <Rectangle id="statusBg" width="1600" height="72" color="0x1E1E2EFF" />
                    <Label id="playlistStatusIcon" translation="[16, 24]" text="!" font="font:MediumBoldSystemFont" color="0xE53935FF" />
                    <Label id="playlistStatusText" translation="[48, 14]" text="No playlist loaded" width="1520"
                        font="font:MediumSystemFont" color="0xE53935FF" />
                    <Label id="playlistCountText" translation="[48, 42]" text="Go to Playlists to add your M3U or Xtream URL" width="1520"
                        font="font:SmallSystemFont" color="0xB3B3B3FF" />
                </Group>

                <!-- Playback Toggles -->
                <Group translation="[0, 160]">
                    <Label text="Auto-play next episode" font="font:MediumSystemFont" color="0xB3B3B3FF" />
                    <LabelList id="autoPlaySelector" translation="[0, 30]" itemSize="[360, 48]" numRows="2"
                        font="font:MediumSystemFont" color="0xE8E8E8FF"
                        focusBitmapBlendColor="0x2E3192FF" />
                </Group>
                <Group translation="[0, 300]">
                    <Label text="Resume on startup" font="font:MediumSystemFont" color="0xB3B3B3FF" />
                    <LabelList id="resumeSelector" translation="[0, 30]" itemSize="[360, 48]" numRows="2"
                        font="font:MediumSystemFont" color="0xE8E8E8FF"
                        focusBitmapBlendColor="0x2E3192FF" />
                </Group>
            </Group>

            <!-- Playback Settings Panel -->
            <Group id="playbackSettings" visible="false">
                <Label text="Playback" font="font:LargeBoldSystemFont" color="0xE8E8E8FF" />
                <Group translation="[0, 60]">
                    <Label text="Buffer Size" font="font:MediumSystemFont" color="0xB3B3B3FF" />
                    <LabelList id="bufferSelector" translation="[0, 30]" itemSize="[360, 48]" numRows="4"
                        font="font:MediumSystemFont" color="0xE8E8E8FF"
                        focusBitmapBlendColor="0x2E3192FF" />
                </Group>
                <Group translation="[0, 300]">
                    <Label text="Default Audio Track" font="font:MediumSystemFont" color="0xB3B3B3FF" />
                    <LabelList id="audioTrackSelector" translation="[0, 30]" itemSize="[360, 48]" numRows="3"
                        font="font:MediumSystemFont" color="0xE8E8E8FF"
                        focusBitmapBlendColor="0x2E3192FF" />
                </Group>
            </Group>

            <!-- Playlists Panel -->
            <Group id="playlistSettings" visible="false">
                <Label text="Playlists" font="font:LargeBoldSystemFont" color="0xE8E8E8FF" />
                <Group translation="[0, 60]">
                    <Label text="Current Playlist" font="font:MediumSystemFont" color="0xB3B3B3FF" />
                    <Label id="currentPlaylistLabel" translation="[0, 36]" width="1560"
                        font="font:MediumSystemFont" color="0xE8E8E8FF" text="None configured" wrap="true" />
                </Group>
                <Group translation="[0, 180]">
                    <LabelList id="playlistActions" translation="[0, 0]" itemSize="[500, 56]" numRows="4"
                        font="font:MediumSystemFont"
                        color="0x2E3192FF"
                        focusedColor="0xE8E8E8FF"
                        focusBitmapBlendColor="0x2E3192FF" />
                </Group>
                <Keyboard id="urlKeyboard" translation="[0, 460]" visible="false" />
            </Group>

            <!-- AI Features Panel -->
            <Group id="aiSettings" visible="false">
                <Label text="AI Features" font="font:LargeBoldSystemFont" color="0xE8E8E8FF" />
                <Label translation="[0, 60]" width="1000" wrap="true"
                    text="Voice search, transcription, and translation features are not yet available on Roku."
                    font="font:MediumSystemFont" color="0xB3B3B3FF" />
            </Group>

            <!-- Recordings Panel -->
            <Group id="recordingsSettings" visible="false">
                <Label text="Recordings" font="font:LargeBoldSystemFont" color="0xE8E8E8FF" />
                <Label translation="[0, 60]" width="1000" wrap="true"
                    text="Cloud recording and scheduled recordings are not yet available on Roku."
                    font="font:MediumSystemFont" color="0xB3B3B3FF" />
            </Group>

        </Group>
    </children>
</component>
