<?xml version="1.0" encoding="utf-8"?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <children>
        <!-- App background: darkBackground #111316 -->
        <Rectangle id="appBackground" width="1920" height="1080" color="0x111316FF" />

        <!-- ========== SIDEBAR (always visible, z-order: on top) ========== -->
        <Sidebar id="sidebar" translation="[0,0]" />

        <!-- ========== STATUS / ERROR ========== -->
        <Group id="loadingOverlay" translation="[900,480]" visible="false">
            <BusySpinner id="spinner" />
            <Label id="statusLabel" translation="[-80,80]" text="Loading..."
                font="font:LargeBoldSystemFont" color="0xE8E8E8FF" />
        </Group>
        <Label id="errorLabel" translation="[100,500]" width="1800"
            font="font:MediumSystemFont" color="0xE53935FF" visible="false" />

        <!-- ========== LIVE TV SCREEN (default, offset past sidebar) ========== -->
        <Group id="liveTVScreen" translation="[56,0]" visible="false">
            <!-- Hero Banner -->
            <Group id="heroSection" translation="[24,20]">
                <Rectangle id="heroBg" width="1840" height="400" color="0x1A1A2EFF" />
                <Poster id="heroImage" width="1840" height="400" loadDisplayMode="scaleToZoom" />
                <Rectangle width="1840" height="400" color="0x00000066" />
                <Rectangle width="1840" height="200" translation="[0,200]" color="0x11131699" />
                <!-- Channel logo -->
                <Group translation="[24,24]">
                    <Rectangle id="logoContainer" width="72" height="72" color="0x000000BB" />
                    <Poster id="heroLogo" translation="[8,8]" width="56" height="56" loadDisplayMode="scaleToFit" />
                </Group>
                <!-- Title + info -->
                <Group translation="[24,240]">
                    <Label id="heroTitle" width="1400" wrap="true" maxLines="2"
                        font="font:HugeBoldSystemFont" color="0xE8E8E8FF" />
                    <Label id="heroChannel" translation="[0,70]" width="600"
                        font="font:MediumSystemFont" color="0xB3B3B3FF" />
                    <Label id="heroTime" translation="[0,100]" width="600"
                        font="font:SmallSystemFont" color="0x808080FF" />
                    <!-- Progress bar -->
                    <Group translation="[0,130]">
                        <Rectangle id="heroProgressBg" width="500" height="4" color="0xFFFFFF33" />
                        <Rectangle id="heroProgressBar" width="0" height="4" color="0x2E3192FF" />
                    </Group>
                </Group>
            </Group>

            <!-- Channel grid / row list -->
            <RowList id="channelGrid" translation="[24,440]"
                itemComponentName="ChannelItem"
                numRows="2"
                itemSize="[200,150]"
                itemSpacing="[16,24]"
                rowItemSize="[[200,150]]"
                rowItemSpacing="[[16,0]]"
                showRowLabel="[true]"
                rowLabelOffset="[[0,-40]]"
                rowLabelColor="0xE8E8E8FF"
                rowLabelFont="font:MediumBoldSystemFont"
                focusBitmapBlendColor="0x2E3192FF"
                drawFocusFeedback="true"
                visible="false" />
        </Group>

        <!-- ========== EPG SCREEN ========== -->
        <Group id="epgContainer" translation="[56,0]" visible="false">
            <EPGScreen id="epgScreen" />
        </Group>

        <!-- ========== SETTINGS SCREEN ========== -->
        <!-- Sits beside the 56px sidebar. SettingsScreen has its own left panel. -->
        <SettingsScreen id="settingsScreen" translation="[56,0]" visible="false" />

        <!-- ========== HOME SCREEN (placeholder for Downloads tab) ========== -->
        <Group id="homeContainer" translation="[56,0]" visible="false">
            <HomeScreen id="homeScreen" />
        </Group>

        <!-- ========== VIDEO PLAYER ========== -->
        <Video id="videoPlayer" width="1920" height="1080" visible="false"
            enableUI="true" enableTrickPlay="true" />

        <!-- ========== SEARCH OVERLAY ========== -->
        <Group id="searchOverlay" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000EE" />
            <Rectangle translation="[300,100]" width="1320" height="880" color="0x1E1E2EFF" />
            <Label translation="[340,140]" text="Search"
                font="font:LargeBoldSystemFont" color="0xE8E8E8FF" />
            <Keyboard id="searchKeyboard" translation="[340,210]" />
            <RowList id="searchResults" translation="[340,560]"
                itemComponentName="ChannelItem"
                numRows="1"
                itemSize="[180,130]"
                itemSpacing="[16,0]"
                visible="false" />
        </Group>

        <!-- ========== CATEGORY MENU ========== -->
        <Group id="categoryMenu" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000EE" />
            <Rectangle translation="[600,50]" width="680" height="980" color="0x1E1E2EFF" />
            <Label translation="[640,90]" text="Categories"
                font="font:LargeBoldSystemFont" color="0xE8E8E8FF" />
            <LabelList id="categoryList" translation="[640,160]"
                itemSize="[600,52]" numRows="15"
                color="0xB3B3B3FF"
                focusedColor="0xE8E8E8FF"
                focusBitmapBlendColor="0x2E3192FF" />
        </Group>
    </children>
</component>
