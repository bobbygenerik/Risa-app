<?xml version="1.0" encoding="utf-8"?>
<component name="HomeScreen" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/HomeScreen.brs" />
    <interface>
        <field id="channels" type="array" onChange="onChannelsLoaded" />
        <field id="itemSelected" type="array" alwaysNotify="true" />
    </interface>
    <children>
        <Label id="titleLabel" translation="[100, 60]" text="Home / Dashboard" font="font:MediumSystemFont" color="0xE8E8E8FF" />
        
        <!-- Dashboard Content Grid placeholder -->
        <RowList id="contentRowList" translation="[100, 140]" 
            itemComponentName="ContentItem" 
            numRows="3"
            itemSize="[300, 160]" 
            itemSpacing="[20, 30]"
            rowItemSize="[[300, 160]]"
            rowItemSpacing="[[20, 0]]"
            showRowLabel="[true]"
            rowLabelOffset="[[0, -40]]"
            rowLabelColor="0xE8E8E8FF"
            rowLabelFont="font:MediumBoldSystemFont"
            focusBitmapBlendColor="0x00A8E8FF"
            drawFocusFeedback="true" />
    </children>
</component>
